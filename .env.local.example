# ── Supabase (required for everything) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (never exposed to the browser). Find in Supabase Dashboard →
# Project Settings → API. Used for migrations, eBay token vault, cron.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: used by `npm run db:types`
SUPABASE_PROJECT_ID=

# ── App ────────────────────────────────────────────────────────────────────
# https URL of your deployment (also used as the eBay OAuth redirect origin)
APP_URL=http://localhost:3000
# Shared secret guarding the cron endpoint. Any long random string.
CRON_SECRET=

# ── eBay (Phase 6/7) ───────────────────────────────────────────────────────
# From developer.ebay.com → Your app → Keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# The RuName you registered for this app (eBay requires redirect URLs be a
# registered "RuName"; it is the redirect_uri in OAuth calls).
EBAY_RUNAME=
# Dev ID from developer.ebay.com → Your app. Required by the legacy Trading API
# (GetMyeBaySelling) used to sync classic/active listings.
EBAY_DEV_ID=
# prod | sandbox
EBAY_ENV=prod
# 32-byte key (hex, 64 chars) used to encrypt the eBay refresh token at rest.
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
EBAY_TOKEN_ENCRYPTION_KEY=